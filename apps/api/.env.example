# Server-side only. Never commit real values and never expose these to the web app.
PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173
# Optional: without these the Coach answers from the rules engine only (labelled as such)
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Billing ---
# none (default) | fake (development only). A real provider (e.g. Razorpay) is NOT implemented yet.
BILLING_PROVIDER=none
BILLING_FAKE_SECRET=
APP_URL=http://localhost:5173
# Service-role key: used ONLY by the billing webhook store. Server-side only; never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=
